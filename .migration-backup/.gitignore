# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets never committed; only the .env.example template is tracked
.env*
!.env.example

# vercel
.vercel

# local IDE / agent tooling
/.trae/

# supabase CLI local state
supabase/.temp/

# Replit — let the Replit environment own its config & env files
.replit
.replit.app
replit.nix
.upm/

# typescript
*.tsbuildinfo
next-env.d.ts
